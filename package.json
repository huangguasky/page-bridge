{
  "name": "page-bridge",
  "version": "0.2.0",
  "description": "在电脑、Kindle 与手机之间轻松传输文件",
  "main": "dist-electron/main/index.js",
  "author": "Page Bridge contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 41731 --strictPort\" \"npm:dev:electron\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "wait-on tcp:127.0.0.1:41731 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:41731 electron .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-store": "latest",
    "express": "latest",
    "foliate-js": "^1.0.1",
    "mime-types": "latest",
    "nanoid": "latest",
    "nodemailer": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/mime-types": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "36.9.5",
    "electron-builder": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "io.github.pagebridge.app",
    "productName": "Page Bridge",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "electron/preload.cjs", "package.json"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "artifactName": "Page-Bridge-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Page-Bridge-${version}-windows-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
